# Local invocation: APP_ENV=local DB_PATH=storage/stockroom.sqlite php -S 127.0.0.1:5123 -t public
# PHP does not automatically load this file. Export values explicitly or use Docker --env-file.
APP_ENV=local
DB_PATH=storage/stockroom.sqlite
SESSION_PATH=storage/sessions
PORT=10000

# Set true only when local files are temporary (e.g. a free Render service).
STOCKROOM_EPHEMERAL_HOSTING=false
